<UserControl x:Class="InstanceManager.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="232">
    <StackPanel>
        <Grid x:Name="SvArea" Height="150" Cursor="Cross" Background="Transparent"
              MouseLeftButtonDown="SvArea_MouseLeftButtonDown" MouseMove="SvArea_MouseMove"
              MouseLeftButtonUp="Area_MouseLeftButtonUp" LostMouseCapture="Area_LostMouseCapture">
            <Border x:Name="HueFill" CornerRadius="8" Background="Red" />
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False" ClipToBounds="False">
                <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="Black" RenderingBias="Performance" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <Grid x:Name="HueBar" Height="16" Margin="0,12,0,0" Cursor="Hand" Background="Transparent"
              MouseLeftButtonDown="HueBar_MouseLeftButtonDown" MouseMove="HueBar_MouseMove"
              MouseLeftButtonUp="Area_MouseLeftButtonUp" LostMouseCapture="Area_LostMouseCapture">
            <Border Height="10" CornerRadius="5" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                        <GradientStop Color="#00FF00" Offset="0.3333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.6667" />
                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False" ClipToBounds="False">
                <Border x:Name="HueThumb" Width="10" Height="16" CornerRadius="3" Background="White"
                        BorderBrush="#33000000" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5" Color="Black" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
            </Canvas>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="HexBox" Style="{StaticResource ModernTextBox}" Height="34" Padding="24,0,10,0"
                         MaxLength="7" CharacterCasing="Upper"
                         TextChanged="HexBox_TextChanged" LostKeyboardFocus="HexBox_LostKeyboardFocus"
                         KeyDown="HexBox_KeyDown" />
                <TextBlock Text="#" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.TextMuted}" />
            </Grid>
            <Border x:Name="Preview" Grid.Column="1" Width="34" Height="34" Margin="8,0,0,0" CornerRadius="8"
                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" />
        </Grid>
    </StackPanel>
</UserControl>
