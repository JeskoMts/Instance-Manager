<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>InstanceManager</RootNamespace>
    <AssemblyName>InstanceManager</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\InstanceManager.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <Product>Instance Manager</Product>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TieredPGO>false</TieredPGO>
    <MvvmToolkitEnableINotifyPropertyChangingSupport>false</MvvmToolkitEnableINotifyPropertyChangingSupport>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <WebView2NeverCopyLoaderDllToOutputDirectory Condition="'$(RuntimeIdentifier)' != ''">true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InstanceManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Logo.png" />
    <EmbeddedResource Include="..\..\docs\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <PublishReadyToRunExclude Include="CommunityToolkit.Mvvm.dll;Microsoft.Extensions.DependencyInjection.dll;Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Web.WebView2.Core.dll;Microsoft.Web.WebView2.Wpf.dll;Microsoft.Web.WebView2.WinForms.dll" />
  </ItemGroup>

</Project>
