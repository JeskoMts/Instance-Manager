<UserControl x:Class="InstanceManager.Views.Settings.ReconnectSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource GroupTitle}" Text="Auto Reconnect" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Auto Reconnect" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Starts an account again when it drops out of its game. Leaving a game yourself or stopping an account here never counts." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding Settings.AutoReconnectMaster}" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <StackPanel IsEnabled="{Binding Settings.AutoReconnectMaster}" Style="{StaticResource DimWhenDisabled}">
                    <Grid Style="{StaticResource SubRow}">
                        <TextBlock Style="{StaticResource SubRowText}" Text="Reconnect after Kick/Error"
                                   ToolTip="Kicks, removals, moderation messages, error 267, lost connections and servers that shut down." />
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.AutoReconnectOnKickError}" />
                    </Grid>
                    <Grid Style="{StaticResource SubRow}">
                        <TextBlock Style="{StaticResource SubRowText}" Text="Reconnect after Instance Crash"
                                   ToolTip="The Roblox window closes unexpectedly, for example after a crash or when it's ended in Task Manager." />
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Settings.AutoReconnectOnCrash}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <StackPanel Margin="0,12,0,10">
                        <Grid>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Retry limit" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SettingValue}" Text="{Binding Value, ElementName=RetrySlider, Converter={StaticResource AttemptsLabel}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource RowHint}" Text="How often one account may reconnect before Auto Reconnect gives up. Slide all the way right for no limit." />
                        <Slider x:Name="RetrySlider" Style="{StaticResource ModernSlider}" Margin="0,10,0,0"
                                Minimum="1" Maximum="31" SmallChange="1" LargeChange="1" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.AutoReconnectMaxAttempts, Delay=150}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource GroupTitle}" Text="Anti-AFK" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Keep clients active" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Roblox kicks players after 20 idle minutes. This briefly brings each running Roblox window to the front and presses a key, then switches back." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Operations.AntiAfkEnabled}" />
                </Grid>
                <StackPanel IsEnabled="{Binding Operations.AntiAfkEnabled}" Style="{StaticResource DimWhenDisabled}">
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Every" />
                            <TextBlock Style="{StaticResource RowHint}" Text="Minutes between key presses, from 1 to 60. Stay below 20." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource ModernTextBox}" Width="70" Height="34" TextAlignment="Right" Padding="10,0"
                                     Text="{Binding Operations.AntiAfkIntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource SuffixText}" Text="min" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Key" />
                            <TextBlock Style="{StaticResource RowHint}" Text="Click the button, then press any key your game doesn't use for anything important. Esc cancels." />
                        </StackPanel>
                        <Button x:Name="AntiAfkKeyButton" Grid.Column="1" Style="{StaticResource KeyButton}" VerticalAlignment="Center"
                                DataContext="{Binding Operations}"
                                Content="{Binding AntiAfkKeyLabel}" Command="{Binding BeginAntiAfkKeyCaptureCommand}"
                                PreviewKeyDown="AntiAfkKeyButton_PreviewKeyDown" LostKeyboardFocus="AntiAfkKeyButton_LostKeyboardFocus"
                                ToolTip="Click, then press the key you want to use" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Switch back afterwards" />
                            <TextBlock Style="{StaticResource RowHint}" Text="Returns to the window you were using after each round." />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Operations.AntiAfkReturnFocus}" />
                    </Grid>
                </StackPanel>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Try it" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Sends one round to every running Roblox window now." />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            Content="Send now" Command="{Binding Operations.SendAntiAfkNowCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
