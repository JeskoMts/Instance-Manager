<UserControl x:Class="InstanceManager.Views.Settings.AppearanceSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:InstanceManager.Behaviors"
             xmlns:ui="clr-namespace:InstanceManager.Controls">
    <UserControl.Resources>
        <Style x:Key="ThemeCardItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ThemeCardVis}">
                        <Binding RelativeSource="{RelativeSource Self}" Path="(ItemsControl.AlternationIndex)" />
                        <Binding RelativeSource="{RelativeSource AncestorType=ListBox}" Path="DataContext.Theme.ShowAllThemes" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ThemeCard_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ThemeCard_PreviewMouseLeftButtonUp" />
            <EventSetter Event="DragOver" Handler="ThemeCard_DragOver" />
            <EventSetter Event="DragLeave" Handler="ThemeCard_DragLeave" />
            <EventSetter Event="Drop" Handler="ThemeCard_Drop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" CornerRadius="10" BorderThickness="1.5" HorizontalAlignment="Stretch"
                                BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Window}">
                            <Grid>
                                <StackPanel>
                                    <Border Height="44" CornerRadius="8,8,0,0"
                                            Background="{Binding Palette.Window, Converter={StaticResource HexToBrush}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <Border Width="34" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                                    Background="{Binding Palette.Accent, Converter={StaticResource HexToBrush}}" />
                                            <Border Width="20" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                                    Background="{Binding Palette.TextSecondary, Converter={StaticResource HexToBrush}}" />
                                            <Border Width="14" Height="14" CornerRadius="7"
                                                    Background="{Binding Palette.Surface, Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="{Binding Palette.BorderStrong, Converter={StaticResource HexToBrush}}" BorderThickness="1" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="10,8,10,9">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,44,0" />
                                        <TextBlock x:Name="CustomTag" Text="Custom" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                                <Border x:Name="ActivatePulse" CornerRadius="8" IsHitTestVisible="False"
                                        Background="{DynamicResource Brush.Accent}" Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                <Setter TargetName="CustomTag" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActivatePulse"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0" Duration="0:0:0.3"
                                                             EasingFunction="{StaticResource EaseOutStandard}"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="behaviors:ThemeDrag.IsDropTarget" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource GroupTitle}" Text="Theme" />
        <Border Style="{StaticResource SettingsCard}" Padding="18,16">
            <StackPanel>
                <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,12"
                           Text="Click a theme to use it, or drag it to change the order. Your own themes can be shared as a code." />
                <ListBox x:Name="ThemesList" ItemsSource="{Binding Theme.Themes}"
                         SelectedItem="{Binding Theme.SelectedTheme, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ThemeCardItem}"
                         AlternationCount="2147483647"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         HorizontalContentAlignment="Stretch"
                         AllowDrop="True"
                         PreviewMouseMove="ThemeCard_PreviewMouseMove"
                         DragOver="ThemesList_DragOver"
                         Drop="ThemesList_Drop"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ThemeGridColumns}}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <WrapPanel x:Name="ThemeActions" Margin="0,2,0,0">
                    <ToggleButton Style="{StaticResource GhostToggleButton}" Content="More themes" Margin="0,0,8,0"
                                  IsChecked="{Binding Theme.ShowAllThemes, Mode=TwoWay}"
                                  Visibility="{Binding Theme.HasMoreThemes, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding Theme.CreateThemeCommand}"
                            ToolTip="Make an editable copy of the current colors">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="Plus" Margin="0,0,7,0" />
                            <TextBlock Text="New theme" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="Rename" Margin="0,0,2,0" Padding="10,0" Height="34"
                            Command="{Binding Theme.EditThemeCommand}" CommandParameter="{Binding Theme.SelectedTheme}"
                            IsEnabled="{Binding Theme.IsCustomSelected}" />
                    <Button Style="{StaticResource IconButton}" Content="Delete" Margin="0,0,2,0" Padding="10,0" Height="34"
                            Command="{Binding Theme.DeleteThemeCommand}" CommandParameter="{Binding Theme.SelectedTheme}"
                            IsEnabled="{Binding Theme.IsCustomSelected}" />
                    <Button Style="{StaticResource IconButton}" Content="Export" Margin="0,0,2,0" Padding="10,0" Height="34"
                            ToolTip="Copy this theme as a code you can share"
                            Command="{Binding Theme.ExportThemeCommand}" CommandParameter="{Binding Theme.SelectedTheme}"
                            IsEnabled="{Binding Theme.IsCustomSelected}" />
                    <Button Style="{StaticResource IconButton}" Content="Import" Padding="10,0" Height="34"
                            ToolTip="Add a theme from a code on your clipboard"
                            Command="{Binding Theme.ImportThemeCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Margin="2,0,0,10">
            <TextBlock Style="{StaticResource GroupTitle}" Text="Custom colors" Margin="0" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Command="{Binding Theme.CustomizeColorsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Setter Property="Content" Value="Customize" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Theme.IsCustomSelected}" Value="True">
                                <Setter Property="Content" Value="Edit colors" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Theme.IsEditingColors}" Value="True">
                                <Setter Property="Content" Value="Done" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <TextBlock Style="{StaticResource RowHint}" Text="{Binding Theme.ColorsHint}" Margin="2,-4,0,10" />
        <Border Style="{StaticResource SettingsCard}" Padding="18,14">
            <ItemsControl ItemsSource="{Binding Theme.ColorTokens}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,18,4" Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="Swatch" Style="{StaticResource SwatchButton}" VerticalAlignment="Center"
                                    Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                    Command="{Binding TogglePickerCommand}" IsEnabled="{Binding IsEditable}"
                                    ToolTip="Pick a color" />
                            <Popup PlacementTarget="{Binding ElementName=Swatch}" Placement="Bottom" VerticalOffset="6"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{Binding IsPickerOpen, Mode=TwoWay}">
                                <Border Padding="14" CornerRadius="12" Background="{DynamicResource Brush.SurfaceHover}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                                    <ContentControl Content="{Binding}" Focusable="False">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <ui:ColorPicker Hex="{Binding Hex, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Border>
                            </Popup>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}" Width="104" Height="32" Padding="10,0"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" CharacterCasing="Upper" MaxLength="7"
                                     IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                                     Text="{Binding Hex, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
