<UserControl x:Class="InstanceManager.Views.Settings.NotificationSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource GroupTitle}" Text="Pop-ups" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <StackPanel Margin="0,12,0,8">
                    <Grid>
                        <TextBlock Style="{StaticResource RowTitle}" Text="Display time" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource SettingValue}" Text="{Binding Value, ElementName=ToastSlider, Converter={StaticResource MsToSec}}" />
                    </Grid>
                    <TextBlock Style="{StaticResource RowHint}" Text="How long a pop-up stays on screen. Every notification stays in the bell at the top right afterwards." />
                    <Slider x:Name="ToastSlider" Style="{StaticResource ModernSlider}" Margin="0,10,0,0" Minimum="500" Maximum="5000"
                            SmallChange="100" LargeChange="500" TickFrequency="100" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.ToastDurationMs, Delay=150}" />
                </StackPanel>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Mute every notification" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Nothing pops up anymore. Everything still lands in the bell. When off, the list below decides." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding Settings.NotifyMuteMaster}" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <StackPanel Margin="0,8,0,8" IsEnabled="{Binding Settings.NotifyMuteMaster, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource DimWhenDisabled}">
                    <TextBlock Style="{StaticResource RowHint}" Text="Mute only these:" Margin="0,4,0,6" />
                    <ItemsControl ItemsSource="{Binding Settings.NotificationMutes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource SubRow}">
                                    <TextBlock Style="{StaticResource SubRowText}" Text="{Binding Label}" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding IsMuted}" ToolTip="On means this kind of notification no longer pops up" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
