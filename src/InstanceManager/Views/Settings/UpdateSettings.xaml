<UserControl x:Class="InstanceManager.Views.Settings.UpdateSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:InstanceManager.Controls">
    <StackPanel>
        <Border Style="{StaticResource SettingsCard}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Updates.VersionTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource RowHint}" Text="{Binding Updates.StatusText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Margin="0,0,8,0" Command="{Binding Updates.WhatsNewCommand}"
                            ToolTip="Open the release notes on GitHub">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="What's new" VerticalAlignment="Center" />
                            <ui:Icon Kind="ExternalLink" Size="13" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Updates.CheckNowCommand}"
                            IsEnabled="{Binding Updates.CanUpdate}"
                            ToolTip="Ask GitHub for the latest version and install it if it is newer"
                            Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                <ui:Icon Kind="Refresh" Size="14" Visibility="{Binding Updates.IsChecking, Converter={StaticResource InverseBoolToVis}}" />
                                <Path Style="{StaticResource Spinner}" Width="13" Height="13" Stroke="{DynamicResource Brush.OnAccent}"
                                      Visibility="{Binding Updates.IsChecking, Converter={StaticResource BoolToVis}}">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <TextBlock Text="Check now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Updates.RestartNowCommand}"
                            Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="Download" Size="14" Margin="0,0,8,0" />
                            <TextBlock Text="Restart to update" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Update automatically" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Asks GitHub for the latest version when the app starts and once an hour. A newer version installs at startup if no Roblox window is open, otherwise when you close the app." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Updates.UpdateAutomatically}" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Verify downloads" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Every download must match the SHA-256 checksum GitHub publishes for it, and only this project's releases are accepted." />
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="11" Padding="10,3" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="ShieldCheck" Size="13" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Success}" />
                            <TextBlock Text="Always on" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Previous version" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{Binding Updates.PreviousText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            Command="{Binding Updates.RollBackCommand}" IsEnabled="{Binding Updates.CanRollBack}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="RotateCcw" Size="14" Margin="0,0,7,0" />
                            <TextBlock Text="Roll back" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
