<UserControl x:Class="InstanceManager.Views.Settings.UpdateSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:InstanceManager.Controls">
    <StackPanel>
        <Border Style="{StaticResource SettingsCard}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Updates.VersionTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource RowHint}" Text="{Binding Updates.StatusText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Margin="0,0,8,0" Command="{Binding Updates.WhatsNewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="What's new" VerticalAlignment="Center" />
                            <ui:Icon Kind="ExternalLink" Size="13" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Content="Skip this version" Margin="0,0,8,0"
                            Command="{Binding Updates.SkipVersionCommand}"
                            Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Updates.CheckNowCommand}"
                            IsEnabled="{Binding Updates.CanUpdate}"
                            Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                <ui:Icon Kind="Refresh" Size="14" Visibility="{Binding Updates.IsChecking, Converter={StaticResource InverseBoolToVis}}" />
                                <Path Style="{StaticResource Spinner}" Width="13" Height="13" Stroke="{DynamicResource Brush.OnAccent}"
                                      Visibility="{Binding Updates.IsChecking, Converter={StaticResource BoolToVis}}">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <TextBlock Text="Check now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Updates.RestartNowCommand}"
                            Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="Download" Size="14" Margin="0,0,8,0" />
                            <TextBlock Text="Restart to update" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource GroupTitle}" Text="Checking" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Check at startup" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Looks for a new version every time Instance Manager starts, and installs it right away if nothing is running." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Updates.CheckOnStartup}" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Check while running" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Looks for updates in the background at this interval, from 15 to 1440 minutes." />
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Width="70" Height="34" TextAlignment="Right" Padding="10,0"
                             Text="{Binding Updates.IntervalMinutes, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding Updates.CheckAutomatically}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource SuffixText}" Text="min" Margin="8,0,16,0" />
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Updates.CheckAutomatically}" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Include pre-releases" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Also offers test versions before they're final." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Updates.IncludePrereleases}" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Skipped version" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{Binding Updates.SkippedText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Offer it again" VerticalAlignment="Center"
                            Command="{Binding Updates.ClearSkippedCommand}"
                            Visibility="{Binding Updates.HasSkipped, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource GroupTitle}" Text="Safety" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Verify downloads" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Every download must match the SHA-256 checksum GitHub publishes for it, and only this project's releases are accepted." />
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="11" Padding="10,3" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="ShieldCheck" Size="13" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Success}" />
                            <TextBlock Text="Always on" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Keep the previous version" />
                        <TextBlock Style="{StaticResource RowHint}" Text="Lets you go back from here if an update causes problems." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Updates.KeepPreviousVersion}" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Previous version" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{Binding Updates.PreviousText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            Command="{Binding Updates.RollBackCommand}" IsEnabled="{Binding Updates.CanRollBack}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="RotateCcw" Size="14" Margin="0,0,7,0" />
                            <TextBlock Text="Roll back" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
