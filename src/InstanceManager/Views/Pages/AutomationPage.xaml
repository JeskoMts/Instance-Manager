<UserControl x:Class="InstanceManager.Views.Pages.AutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:InstanceManager.Behaviors"
             xmlns:ui="clr-namespace:InstanceManager.Controls">
    <UserControl.Resources>
        <Style x:Key="EditorName" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MaxLength" Value="5" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="24-hour time, for example 18:30. Up and Down change it by 5 minutes." />
            <Style.Triggers>
                <Trigger Property="Tag" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickTile" TargetType="ToggleButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="9" BorderThickness="1" Padding="10,0"
                                Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border x:Name="Box" CornerRadius="5" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource Brush.BorderStrong}" />
                                    <Border x:Name="Fill" CornerRadius="5" Background="{DynamicResource Brush.Accent}" Opacity="0">
                                        <ui:Icon Kind="Check" Size="12" StrokeThickness="2.6" Foreground="{DynamicResource Brush.OnAccent}" />
                                    </Border>
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="15" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" DataContext="{Binding Automation}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,4,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="Automation" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Saved sets of accounts that start with one click or on a schedule." />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                    Command="{Binding NewAutomationCommand}"
                    ToolTip="Takes the accounts selected on the Accounts page and the game or server in the launch bar"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Kind="Plus" Size="14" Margin="0,0,8,0" />
                    <TextBlock Text="New automation" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,0,28,80"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="No automations yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="An automation remembers a set of accounts and where they go, so you can start them all at once." />
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                    Command="{Binding NewAutomationCommand}"
                    ToolTip="Takes the accounts selected on the Accounts page and the game or server in the launch bar">
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Kind="Plus" Size="14" Margin="0,0,8,0" />
                    <TextBlock Text="New automation" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,0,28,20" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="AutomationList" Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource ListCardItem}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" behaviors:SmoothScroll.Enabled="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.Success}" ToolTip="{Binding RunningText}"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding ListSubtitle}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ScheduleText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Visibility="{Binding ScheduleEnabled, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Padding="0"
                                        Command="{Binding RunCommand}" ToolTip="Run this automation now"
                                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                                    <ui:Icon Kind="Play" Size="14" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Padding="0"
                                        Command="{Binding StopNowCommand}" ToolTip="Close the Roblox windows of its accounts"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <ui:Icon Kind="Stop" Size="13" />
                                </Button>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer x:Name="EditorScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          behaviors:SmoothScroll.Enabled="True" DataContext="{Binding Selected}"
                          Visibility="{Binding DataContext.HasSelection, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="720" />
                        <ColumnDefinition Width="0" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NameBox" Style="{StaticResource EditorName}" ToolTip="Name of this automation"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Height="40" Content="Stop"
                                    Command="{Binding StopNowCommand}"
                                    ToolTip="Close the Roblox windows of these accounts"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Height="40" MinWidth="84" Command="{Binding RunCommand}"
                                    ToolTip="Start these accounts now, one after another">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Kind="Play" Size="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Run" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="36" Height="36" Padding="0" Margin="4,0,0,0"
                                    ToolTip="More: duplicate or delete" Click="More_Click">
                                <ui:Icon Kind="More" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"
                                                  ToolTip="The copy starts with its schedule off">
                                            <MenuItem.Icon>
                                                <ui:Icon Kind="Copy" Size="15" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" Foreground="{DynamicResource Brush.Danger}"
                                                  ToolTip="You can undo it from the notification">
                                            <MenuItem.Icon>
                                                <ui:Icon Kind="Trash" Size="15" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                        <DockPanel Margin="2,8,0,20">
                            <TextBlock DockPanel.Dock="Right" FontSize="12" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Success}"
                                       Text="{Binding RunningText}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding NextText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                        </DockPanel>

                        <Border Style="{StaticResource SettingsCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Accounts" />
                                        <TextBlock Text="{Binding DataContext.PickSummary, ElementName=Root}" FontSize="12" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-4,-8,-4"
                                                Visibility="{Binding DataContext.HasAccounts, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource LinkButton}" Content="All" FontSize="12"
                                                Command="{Binding DataContext.SelectAllAccountsCommand, ElementName=Root}"
                                                ToolTip="Select every account in the list" />
                                        <Button Style="{StaticResource LinkButton}" Content="None" FontSize="12"
                                                Command="{Binding DataContext.SelectNoAccountsCommand, ElementName=Root}"
                                                ToolTip="Clear every account" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0" Visibility="{Binding DataContext.ShowAccountSearch, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                    <TextBox x:Name="AccountSearchBox" Style="{StaticResource SearchTextBox}" Height="32" VerticalContentAlignment="Center"
                                             Text="{Binding DataContext.AccountSearch, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                    <ui:Icon Kind="Search" Size="13" HorizontalAlignment="Left" Margin="12,0,0,0"
                                             Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                                    <TextBlock Style="{StaticResource WatermarkText}" Margin="32,0,0,0" Text="Find an account">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource EmptyUnfocusedToVis}">
                                                <Binding Path="Text" ElementName="AccountSearchBox" />
                                                <Binding Path="IsKeyboardFocused" ElementName="AccountSearchBox" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DataContext.GroupPicks, ElementName=Root}" Margin="0,12,0,-6"
                                              Visibility="{Binding DataContext.HasGroups, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChipButton}" Tag="{Binding IsComplete}"
                                                    Command="{Binding DataContext.ToggleGroupCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    ToolTip="Select or clear every account in this group">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl x:Name="PickList" ItemsSource="{Binding DataContext.AccountPicks, ElementName=Root}" Focusable="False"
                                              Margin="0,12,-8,-8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top"
                                                         Columns="{Binding ActualWidth, ElementName=PickList, Converter={StaticResource ThemeGridColumns}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource PickTile}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Username}">
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                                             Fill="{DynamicResource Brush.Success}" ToolTip="Running"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Username}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No account matches your search." FontSize="12" Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextMuted}"
                                           Visibility="{Binding DataContext.NoAccountMatches, ElementName=Root, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Add accounts on the Accounts page first." FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                           Visibility="{Binding DataContext.HasAccounts, ElementName=Root, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Destination" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentRadio}" Content="Game" GroupName="automationMode"
                                                         IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=PublicByLink}" />
                                            <RadioButton Style="{StaticResource SegmentRadio}" Content="Server" GroupName="automationMode"
                                                         IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=PrivateByJobId}" />
                                            <RadioButton Style="{StaticResource SegmentRadio}" Content="Home screen" GroupName="automationMode"
                                                         IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=Home}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Visibility="{Binding NeedsTarget, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,12,0,0">
                                        <TextBox x:Name="TargetBox" Style="{StaticResource ModernTextBox}" Height="34" Padding="10,0"
                                                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                        <TextBlock Style="{StaticResource WatermarkText}" Margin="11,0" Text="{Binding TargetHint}">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource EmptyUnfocusedToVis}">
                                                    <Binding Path="Text" ElementName="TargetBox" />
                                                    <Binding Path="IsKeyboardFocused" ElementName="TargetBox" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>

                                    <DockPanel Margin="1,8,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="12" Padding="0" Margin="12,0,0,0"
                                                Command="{Binding DataContext.UseLaunchBarTargetCommand, ElementName=Root}"
                                                Content="Use launch bar target"
                                                ToolTip="Copy the game or server from the launch bar on the Accounts page" />
                                        <TextBlock Text="{Binding DestinationName}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding DataContext.Favorites, ElementName=Root}" Margin="0,12,0,-6"
                                                  Visibility="{Binding DataContext.HasFavorites, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" ToolTip="Use this favorite as the destination"
                                                        Command="{Binding DataContext.UseFavoriteCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Padding="18,16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Schedule" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="Start and close these accounts at set times." />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding ScheduleEnabled}" />
                                </Grid>

                                <StackPanel Visibility="{Binding ScheduleEnabled, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource RowDivider}" Margin="0,16,0,0" />

                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Days" />
                                        <ItemsControl ItemsSource="{Binding Days}" Focusable="False" Margin="0,10,-6,-6"
                                                      ToolTip="With no day picked, the schedule runs every day">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource DayToggle}" Margin="0,0,6,6" Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid Margin="0,18,0,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Start at" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBox Style="{StaticResource TimeBox}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Tag="{Binding StartTimeIsValid}" IsEnabled="{Binding StartOnSchedule}"
                                                     PreviewKeyDown="TimeBox_PreviewKeyDown"
                                                     Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                            <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                      IsChecked="{Binding StartOnSchedule}" ToolTip="Turn off to only close the accounts on a schedule" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Close" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                                        Visibility="{Binding IsStopAfter, Converter={StaticResource BoolToVis}}">
                                                <TextBox Style="{StaticResource ModernTextBox}" Width="64" Height="34" Padding="10,0" TextAlignment="Right"
                                                         ToolTip="Minutes after the start, from 1 to 1440 (24 hours)"
                                                         Text="{Binding StopAfterMinutes, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                                <TextBlock Style="{StaticResource SuffixText}" Text="min" />
                                            </StackPanel>
                                            <TextBox Style="{StaticResource TimeBox}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                     Tag="{Binding StopTimeIsValid}" PreviewKeyDown="TimeBox_PreviewKeyDown"
                                                     ToolTip="24-hour time. A time earlier than the start means the next day."
                                                     Visibility="{Binding IsStopAt, Converter={StaticResource BoolToVis}}"
                                                     Text="{Binding StopTime, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                            <Border Style="{StaticResource SegmentHost}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Never" GroupName="automationStop"
                                                                 ToolTip="The Roblox windows stay open"
                                                                 IsChecked="{Binding StopMode, Converter={StaticResource EnumBool}, ConverterParameter=Never}" />
                                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="After" GroupName="automationStop"
                                                                 IsChecked="{Binding StopMode, Converter={StaticResource EnumBool}, ConverterParameter=AfterMinutes}" />
                                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="At" GroupName="automationStop"
                                                                 IsChecked="{Binding StopMode, Converter={StaticResource EnumBool}, ConverterParameter=AtTime}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,16,0,0"
                                               Text="Schedules only run while Instance Manager is open or in the tray." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
