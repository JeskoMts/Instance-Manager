<UserControl x:Class="InstanceManager.Views.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:InstanceManager.Behaviors"
             xmlns:ui="clr-namespace:InstanceManager.Controls">
    <Grid DataContext="{Binding Games}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,4,28,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="Games" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Search for a game and pick it to set it as the launch target on the Accounts page." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,0,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="340" HorizontalAlignment="Left">
                <TextBox x:Name="GamesSearchBox" Style="{StaticResource SearchTextBox}" Height="34"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                <ui:Icon Kind="Search" Size="15" HorizontalAlignment="Left" Margin="12,0,0,0"
                         Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Style="{StaticResource WatermarkText}" Margin="34,0,0,0" Text="Search Roblox games"
                           IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource EmptyUnfocusedToVis}">
                            <Binding Path="Text" ElementName="GamesSearchBox" />
                            <Binding Path="IsKeyboardFocused" ElementName="GamesSearchBox" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Clear search"
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                    <ui:Icon Kind="Close" Size="13" />
                </Button>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Path Style="{StaticResource Spinner}" Width="13" Height="13" Margin="0,0,8,0">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                </Path>
                <TextBlock Text="Loading games…" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="28,0,16,0">
            <ScrollViewer x:Name="GamesScroller" behaviors:SmoothScroll.Enabled="True"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,4,6,8">
                <ItemsControl ItemsSource="{Binding Games}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, ElementName=GamesScroller, Converter={StaticResource GameGridColumns}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Margin="0,0,12,12"
                                    Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                <Border x:Name="Card" CornerRadius="12" BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        Background="{DynamicResource Brush.Surface}">
                                    <StackPanel>
                                        <ui:AspectRatioBox Ratio="0.5625">
                                        <Grid>
                                            <Border CornerRadius="11,11,0,0" Background="{DynamicResource Brush.Elevated}">
                                                <ui:Icon Kind="Gamepad" Size="28" Foreground="{DynamicResource Brush.TextMuted}" />
                                            </Border>
                                            <Border CornerRadius="11,11,0,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Border x:Name="Check" Width="24" Height="24" CornerRadius="12" Margin="0,8,8,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                                                    Background="{DynamicResource Brush.Accent}">
                                                <ui:Icon Kind="Check" Size="14" StrokeThickness="2.6" Foreground="{DynamicResource Brush.OnAccent}" />
                                            </Border>
                                        </Grid>
                                        </ui:AspectRatioBox>
                                        <StackPanel Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.TextMuted}">
                                                <Run Text="{Binding PlayerCountText, Mode=OneWay}" /><Run Text=" playing" />
                                                <Run Text=" · " /><Run Text="{Binding CreatorName, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No games found. Try another name, or paste a game link." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
