<Window x:Class="InstanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:InstanceManager.ViewModels"
        xmlns:behaviors="clr-namespace:InstanceManager.Behaviors"
        xmlns:pages="clr-namespace:InstanceManager.Views.Pages"
        xmlns:ui="clr-namespace:InstanceManager.Controls"
        Title="Instance Manager" Height="720" Width="1120" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageHost" TargetType="FrameworkElement">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="0:0:0.18" EasingFunction="{StaticResource EaseOutStandard}" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="6" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource EaseOutEmphasized}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="11,0,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SidebarToggleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                         Duration="0:0:0.22" EasingFunction="{StaticResource EaseOutStandard}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Border x:Name="Sidebar" Grid.Column="0" Grid.Row="0" Width="224" ClipToBounds="True"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
                Background="{DynamicResource Brush.Window}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource EaseOutEmphasized}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="224" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOutEmphasized}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="10,0,10,10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="56" Margin="6,0,0,4">
                    <Image Source="/Assets/Logo.png" Width="22" Height="22" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Instance Manager" FontSize="14" FontWeight="SemiBold" Style="{StaticResource NavLabel}" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EnumBool}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="Settings" Size="17" />
                            <TextBlock Text="Settings" Style="{StaticResource NavLabel}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EnumBool}, ConverterParameter=Accounts}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="Users" Size="17" />
                            <TextBlock Text="Accounts" Style="{StaticResource NavLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EnumBool}, ConverterParameter=Games}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="Gamepad" Size="17" />
                            <TextBlock Text="Games" Style="{StaticResource NavLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EnumBool}, ConverterParameter=Automation}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Kind="Zap" Size="17" />
                            <TextBlock Text="Automation" Style="{StaticResource NavLabel}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Style="{StaticResource SidebarToggleButton}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="34" Height="34" Padding="0" Margin="20,0,0,0"
                    Command="{Binding ToggleSidebarCommand}" ToolTip="Open or close the sidebar"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ui:Icon Kind="PanelLeft" Size="17" />
            </Button>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="DiscordButton" Click="DiscordButton_Click" Margin="0,0,2,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#5865F2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <StackPanel>
                            <TextBlock Text="Join the Discord" FontWeight="SemiBold" />
                            <TextBlock Text="Ideas, questions and bug reports." Margin="0,2,0,0"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Button.ToolTip>
                    <ui:Icon Kind="Discord" Size="17" />
                </Button>
                <Grid shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
                    <Button x:Name="BellButton" Style="{StaticResource CaptionButton}"
                            Command="{Binding Notifications.ToggleCenterCommand}" ToolTip="Notifications">
                        <ui:Icon Kind="Bell" />
                    </Button>
                    <Border IsHitTestVisible="False" MinWidth="15" Height="15" CornerRadius="7.5" Padding="3,0"
                            Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,2,6,0"
                            Visibility="{Binding Notifications.HasUnread, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Notifications.UnreadBadge}" Foreground="{DynamicResource Brush.OnAccent}"
                                   FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Border Width="1" Height="18" Margin="0,0,8,0" Background="{DynamicResource Brush.Border}" />
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="MinButton_Click" ToolTip="Minimize">
                    <ui:Icon Kind="Minimize" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="MaxButton_Click" ToolTip="Maximize">
                    <ui:Icon x:Name="MaxIcon" Kind="Maximize" Size="15" StrokeThickness="1.6" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="CloseButton_Click" ToolTip="Close">
                    <ui:Icon Kind="Close" StrokeThickness="1.5" />
                </Button>
            </StackPanel>

            <Grid Grid.Row="1">
                <pages:AccountsPage x:Name="AccountsView" Style="{StaticResource PageHost}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource EnumVis}, ConverterParameter=Accounts}" />
                <ui:DeferredContent x:Name="GamesView" Style="{StaticResource PageHost}" ContentType="{x:Type pages:GamesPage}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource EnumVis}, ConverterParameter=Games}" />
                <ui:DeferredContent x:Name="AutomationView" Style="{StaticResource PageHost}" ContentType="{x:Type pages:AutomationPage}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource EnumVis}, ConverterParameter=Automation}" />
                <ui:DeferredContent x:Name="SettingsView" Style="{StaticResource PageHost}" ContentType="{x:Type pages:SettingsPage}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource EnumVis}, ConverterParameter=Settings}" />
            </Grid>
        </Grid>

        <ItemsControl Grid.ColumnSpan="2" Grid.RowSpan="2" Panel.ZIndex="100"
                      ItemsSource="{Binding Notifications.Items}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,20,20" IsHitTestVisible="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Width="340" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Margin="0,8,0,0" CornerRadius="12" BorderThickness="1" Opacity="0"
                            Background="{DynamicResource Brush.SurfaceHover}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Shift" Y="14" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000" RenderingBias="Performance" />
                        </Border.Effect>
                        <Grid Margin="14,12,8,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Top">
                                <Ellipse x:Name="ChipBg" Fill="{DynamicResource Brush.Accent}" Opacity="0.16" />
                                <ui:Icon x:Name="ChipGlyph" Kind="Info" Size="15" Foreground="{DynamicResource Brush.Accent}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" LineHeight="17" />
                                <Button Content="{Binding ActionLabel}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,9,0,0"
                                        Command="{Binding DataContext.Notifications.UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0"
                                    VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Dismiss"
                                    Command="{Binding DataContext.Notifications.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <ui:Icon Kind="Close" Size="12" />
                            </Button>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NotificationKind.Success}">
                            <Setter TargetName="ChipBg" Property="Fill" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="ChipGlyph" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="ChipGlyph" Property="Kind" Value="Check" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NotificationKind.Error}">
                            <Setter TargetName="ChipBg" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="ChipGlyph" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="ChipGlyph" Property="Kind" Value="AlertCircle" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsClosing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y"
                                                         To="8" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOutStandard}" />
                                    <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y"
                                                     To="0" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOutEmphasized}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Panel.ZIndex="90" Background="Transparent"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Visibility="{Binding Notifications.IsCenterOpen, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonDown="NotificationScrim_Click" />

        <Border x:Name="NotificationTray" Grid.ColumnSpan="2" Grid.RowSpan="2" Panel.ZIndex="95" Width="360" MaxHeight="460"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,110,0"
                Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1" CornerRadius="12"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Visibility="{Binding Notifications.IsCenterOpen, Converter={StaticResource BoolToVis}}">
            <Border.RenderTransform>
                <TranslateTransform Y="0" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="-6" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOutEmphasized}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="6">
                <Grid DockPanel.Dock="Top" Margin="10,6,4,8">
                    <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="9,4" Content="Clear all" FontSize="12"
                            Command="{Binding Notifications.ClearHistoryCommand}"
                            Visibility="{Binding Notifications.HasHistory, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30"
                                Visibility="{Binding Notifications.HasHistory, Converter={StaticResource InverseBoolToVis}}">
                        <ui:Icon Kind="Bell" Size="28" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="Nothing new" Foreground="{DynamicResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScroll.Enabled="True"
                                  Visibility="{Binding Notifications.HasHistory, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Notifications.History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Item" Margin="0,1" Padding="10,9" CornerRadius="9" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Grid.Column="0" Width="7" Height="7" Margin="0,6,11,0" VerticalAlignment="Top"
                                                     Fill="{DynamicResource Brush.TextMuted}" />
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,40,0" />
                                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Brush.TextMuted}"
                                                               FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" />
                                                <Button Content="{Binding ActionLabel}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,7,0,0"
                                                        Command="{Binding DataContext.Notifications.UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0"
                                                    VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Remove"
                                                    Command="{Binding DataContext.Notifications.RemoveFromHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ui:Icon Kind="Close" Size="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NotificationKind.Success}">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NotificationKind.Error}">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
